# Copiar a .env (o cargar como env vars del stack en Portainer).
# El .env real nunca se commitea: las local keys permiten controlar los devices desde la LAN.

# ~/tuya-keys/fetch_keys.py <user_code> > devices-qr.json, campo "key" de cada device.
TUYA_KEY_FAN=
TUYA_KEY_LIGHT=
TUYA_KEY_CURTAIN=

# @BotFather > /newbot. El chat tiene que haberle mandado /start al bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Opcional. IP de la TV; despues: docker exec -it automati python -m automati.pair_tv
TV_HOST=
