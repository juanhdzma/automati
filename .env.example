# Copiar a .env (o cargar como env vars del stack en Portainer).
# El .env real nunca se commitea: HOME_TOKEN da control total sobre la casa.

HA_URL=https://home.nufi.com.co

# Home Assistant > perfil > Long-lived access tokens > crear token
HOME_TOKEN=

# @BotFather > /newbot. El chat tiene que haberle mandado /start al bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
